}

model DeletionHistory {
  id          String             @id @default(uuid())
  tenantId    String             @default("00000000-0000-4000-8000-000000000010")
  companyId   String             @default("00000000-0000-4000-8000-000000000001")
  entityType  DeletionEntityType
  entityId    String
  title       String?
  metadata    Json?
  deletedById String
  deletedAt   DateTime           @default(now())
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedBy   User               @relation("DeletionHistoryActor", fields: [deletedById], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([companyId, deletedAt])
  @@index([entityType, deletedAt])
  @@index([deletedById])
  @@map("deletion_history")
  @@schema("dev")
}

model Deliverable {
  id             String                    @id @default(uuid())
  tenantId       String                    @default("00000000-0000-4000-8000-000000000010")
  companyId      String                    @default("00000000-0000-4000-8000-000000000001")
  title          String
  clientId       String?
  kanbanTaskId   String?                   @unique
  contentPostId  String?                   @unique
  approvalStatus DeliverableApprovalStatus @default(DRAFT)
  approvedAt     DateTime?
  approvedById   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  items          DeliverableItem[]
  approvedBy     User?                     @relation("DeliverableApprovedBy", fields: [approvedById], references: [id])
  client         Client?                   @relation(fields: [clientId], references: [id])
  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentPost    ContentPost?              @relation(fields: [contentPostId], references: [id])
  kanbanTask     KanbanTask?               @relation(fields: [kanbanTaskId], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([companyId])
  @@index([clientId])
  @@index([approvalStatus])
  @@map("deliverables")
  @@schema("dev")
}

model DeliverableItem {
  id              String                @id @default(uuid())
  deliverableId   String
  mediaUrl        String
  mediaType       DeliverableMediaType  @default(OTHER)
  status          DeliverableItemStatus @default(PENDING)
  adjustmentNotes String?
  fileName        String?
  fileSize        Int?
  storageBucket   String?
  storagePath     String?
  sourceAssetId   String?
  sortOrder       Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deliverable     Deliverable           @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, sortOrder])
  @@index([status])
  @@index([sourceAssetId])
  @@map("deliverable_items")
  @@schema("dev")
}

