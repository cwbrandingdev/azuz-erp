DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=dev"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&schema=dev"

SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_DB_SCHEMA="public"
SUPABASE_STORAGE_BUCKET="avatars"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

PORT=3001
# Local k6 load tests only (non-production): K6_LOAD_TEST=1 npm run start:dev
K6_LOAD_TEST=
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,https://atria-erp.vercel.app"
COOKIE_DOMAIN=""
TENANT_SECRETS_KEY=""
COMPANY_EMAIL_DOMAIN="cwbranding.com"
APP_URL="https://azuz.cwbranding.com.br"
ADMIN_EMAIL="admin@atria.com"
# Local dev only — never commit real values. Used by prisma db seed / npm run seed:master
SEED_MASTER_EMAIL=""
SEED_MASTER_PASSWORD=""
SEED_MASTER_NAME="Admin"
# Mail — HostGator Titan SMTP (free with hosting; one mailbox as sender).
# Recipients are User.email from /settings/users (Gmail or Titan).
MAIL_FROM="Atria <you@your-titan-domain.com>"
MAIL_PROVIDER="smtp"
RESEND_API_KEY=""
SMTP_HOST="smtp.titan.email"
SMTP_PORT="587"
SMTP_USER="you@your-titan-domain.com"
SMTP_PASS=""
SMTP_SECURE="false"
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

TENANT_SECRETS_KEY=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID="act_781471881330330"
META_API_VERSION="v19.0"

OUTSCRAPER_API_KEY=""
APIFY_API_TOKEN=""
APIFY_INSTAGRAM_ACTOR="apify~instagram-scraper"
LEAD_QUALIFICATION_USE_AI="false"
APIFY_GOOGLE_MAPS_ACTOR="compass~crawler-google-places"
APIFY_MAX_RESULTS="25"
LEAD_SCRAPER_URL="https://leadminer-one.vercel.app/api/scraper"
LEADMINER_API="https://lead-miner.fly.dev"

# Twilio Voice — sequential lead dialer (optional)
# Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_TWIML_APP_SID=""
TWILIO_CALLER_ID="+5511..."
# Public backend URL Twilio can reach (ngrok in local, Fly in prod)
TWILIO_WEBHOOK_BASE_URL="https://your-ngrok.ngrok.io"
# native = liga no celular/PC (grátis). twilio = softphone pago.
DIALER_MODE="native"

META_APP_ID=""
META_APP_SECRET=""

# WAHA — self-hosted WhatsApp HTTP API (docker-compose.waha.yml).
# The inbox talks only to this server. Pair the number from the inbox settings.
WAHA_BASE_URL="http://127.0.0.1:3010"
WAHA_API_KEY="dev-waha-key"
WAHA_SESSION="default"
# URL the WAHA container can reach. host.docker.internal is mapped in the compose file.
WAHA_WEBHOOK_URL="http://host.docker.internal:3001/whatsapp-webhook"
WAHA_WEBHOOK_HMAC_KEY=""

# Google Calendar — creates the Meet link from the leads kanban.
# OAuth client with calendar.events and meetings.space.created, plus a refresh token for the
# account that should own the meetings. Leave empty to save meetings only
# on the internal agenda.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
