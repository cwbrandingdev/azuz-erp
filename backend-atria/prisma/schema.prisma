model SystemSuggestion {
  id            String                 @id @default(uuid())
  tenantId      String                 @default("00000000-0000-4000-8000-000000000010")
  type          SystemSuggestionType
  title         String
  description   String
  status        SystemSuggestionStatus @default(OPEN)
  submittedById String                 @map("submitted_by_id")
  companyId     String                 @default("00000000-0000-4000-8000-000000000001")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  submittedBy   User                   @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([companyId])
  @@index([submittedById])
  @@index([status])
  @@map("system_suggestions")
  @@schema("dev")
}

model AppUpdate {
