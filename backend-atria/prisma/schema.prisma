generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["dev"]
}

model Tenant {
  id                         String                      @id @default(uuid())
  name                       String
  slug                       String                      @unique
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  companies                  Company[]
  users                      User[]
  invitationTokens           InvitationToken[]
  messages                   Message[]
  financialCategories        FinancialCategory[]
  financialTransactions      FinancialTransaction[]
  kanbanColumns              KanbanColumn[]
  kanbanTasks                KanbanTask[]
  calendarEvents             CalendarEvent[]
  clients                    Client[]
  userGroups                 UserGroup[]
  clientGroups               ClientGroup[]
  clientReports              ClientReport[]
  clientBriefs               ClientBrief[]
  contentPosts               ContentPost[]
  contracts                  Contract[]
  proposals                  Proposal[]
  assets                     Asset[]
  notifications              Notification[]
  agencySettings             AgencySettings[]
  artTypePricing             ArtTypePricing[]
  calendarEntries            CalendarEntry[]
  agendaEvents               AgendaEvent[]
  clientRequests             ClientRequest[]
  clientFinancialAttachments ClientFinancialAttachment[]
  tasks                      Task[]
  clientReportFiles          ClientReportFile[]
  leadStages                 LeadStage[]
  crmReminderTasks           CrmReminderTask[]
  leads                      Lead[]
  deletionHistory            DeletionHistory[]
  deliverables               Deliverable[]
  systemSuggestions          SystemSuggestion[]
  appUpdates                 AppUpdate[]

  @@schema("dev")
}

model Company {
  id                         String                      @id @default(uuid())
  tenantId                   String                      @default("00000000-0000-4000-8000-000000000010")
  name                       String
  subdomain                  String                      @unique
  status                     CompanyStatus               @default(ACTIVE)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  metaAdAccountId            String?
  metaPageAccessToken        String?
  metaAppId                  String?
  metaAppSecret              String?
  apifyApiToken              String?
  whatsappApiToken           String?
  hasCrmModuleEnabled        Boolean                     @default(false) @map("has_crm_module_enabled")
  agencySettings             AgencySettings?
  assets                     Asset[]
  calendarEvents             CalendarEvent[]
  clients                    Client[]
  clientBriefs               ClientBrief[]
  clientGroups               ClientGroup[]
  clientReports              ClientReport[]
  contentPosts               ContentPost[]
  contracts                  Contract[]
  financialCategories        FinancialCategory[]
  financialTransactions      FinancialTransaction[]
  kanbanColumns              KanbanColumn[]
  kanbanTasks                KanbanTask[]
  messages                   Message[]
  proposals                  Proposal[]
  users                      User[]
  userGroups                 UserGroup[]
  agendaEvents               AgendaEvent[]
  artTypePricing             ArtTypePricing[]
  calendarEntries            CalendarEntry[]
  clientFinancialAttachments ClientFinancialAttachment[]
  clientReportFiles          ClientReportFile[]
  clientRequests             ClientRequest[]
  representatives            CompanyRepresentative[]
  crmReminderTasks           CrmReminderTask[]
  deletionHistory            DeletionHistory[]
  deliverables               Deliverable[]
  invitationTokens           InvitationToken[]
  leadStages                 LeadStage[]
  leads                      Lead[]
  notifications              Notification[]
  systemSuggestions          SystemSuggestion[]
  appUpdates                 AppUpdate[]
  tasks                      Task[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@schema("dev")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions String[] @default([])
  users       User[]

  @@schema("dev")
}

model User {
  id                           String                  @id @default(uuid())
  tenantId                     String                  @default("00000000-0000-4000-8000-000000000010")
  email                        String
  passwordHash                 String
  name                         String
  avatarUrl                    String?
  roleId                       String
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  monthlySalary                Decimal?                @db.Decimal(12, 2)
  userGroupId                  String?
  mustChangePassword           Boolean                 @default(true)
  temporaryPassword            String?
  clientId                     String?
  companyId                    String                  @default("00000000-0000-4000-8000-000000000001")
  category                     UserCategory            @default(MEMBER)
  isActive                     Boolean                 @default(true)
  assetsUploaded               Asset[]                 @relation("AssetUploader")
  authTokens                   AuthToken[]
  eventsAssigned               CalendarEvent[]         @relation("EventAssignee")
  eventsCreated                CalendarEvent[]         @relation("EventCreator")
  clientBriefsAssigned         ClientBrief[]           @relation("BriefAssignee")
  reportsGenerated             ClientReport[]          @relation("ReportGenerator")
  assignedPosts                ContentPost[]           @relation("PostAssignee")
  contentPosts                 ContentPost[]
  contractsCreated             Contract[]              @relation("ContractCreator")
  deletedFinancialTransactions FinancialTransaction[]  @relation("FinancialTransactionDeletedBy")
  transactions                 FinancialTransaction[]
  kanbanTasksCreated           KanbanTask[]            @relation("KanbanTaskCreator")
  deletedKanbanTasks           KanbanTask[]            @relation("KanbanTaskDeletedBy")
  kanbanTaskAssetsUploaded     KanbanTaskAsset[]       @relation("KanbanTaskAssetUploader")
  kanbanAssignments            KanbanTaskAssignee[]
  postFeedback                 PostFeedback[]
  postVersions                 PostVersion[]
  proposalsCreated             Proposal[]              @relation("ProposalCreator")
  taskComments                 TaskComment[]
  taskHistory                  TaskHistory[]
  client                       Client?                 @relation("ClientUsers", fields: [clientId], references: [id])
  company                      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                         Role                    @relation(fields: [roleId], references: [id])
  userGroup                    UserGroup?              @relation(fields: [userGroupId], references: [id])
  userGroups                   UserGroupMember[]
  settings                     UserSettings?
  clientRequestComments        ClientRequestComment[]
  companyRepresentatives       CompanyRepresentative[]
  sdrAssignments               CrmSdrAssignment[]
  deletionHistory              DeletionHistory[]       @relation("DeletionHistoryActor")
  deliverablesApproved         Deliverable[]           @relation("DeliverableApprovedBy")
  createdInvitations           InvitationToken[]       @relation("InvitationCreatedBy")
  leadComments                 LeadComment[]
  deletedLeads                 Lead[]                  @relation("LeadDeletedBy")
  notifications                Notification[]
  assignedTasks                Task[]                  @relation("TaskDesigner")
  crmScopes                    UserCrmScope[]
  systemSuggestions            SystemSuggestion[]
  appUpdatesCreated            AppUpdate[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([companyId, email])
  @@index([tenantId, id])
  @@index([clientId])
  @@index([category])
  @@index([companyId, category])
  @@index([companyId])
  @@index([isActive])
  @@schema("dev")
}

model InvitationToken {
  id          String   @id @default(uuid())
  tenantId    String   @default("00000000-0000-4000-8000-000000000010")
  token       String   @unique
  role        RoleName
  companyId   String   @default("00000000-0000-4000-8000-000000000001")
  used        Boolean  @default(false)
  expiresAt   DateTime @map("expires_at")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("InvitationCreatedBy", fields: [createdById], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([companyId])
  @@index([token])
  @@index([expiresAt])
  @@map("invitation_tokens")
  @@schema("dev")
}

model CompanyRepresentative {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  title     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_representatives")
  @@schema("dev")
}

model AuthToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("dev")
}

model Message {
  id        String   @id @default(uuid())
  tenantId  String   @default("00000000-0000-4000-8000-000000000010")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String   @default("00000000-0000-4000-8000-000000000001")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([companyId])
  @@schema("dev")
}

model FinancialCategory {
  id           String                 @id @default(uuid())
  tenantId     String                 @default("00000000-0000-4000-8000-000000000010")
  name         String
  type         TransactionType
  color        String                 @default("#004949")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  companyId    String                 @default("00000000-0000-4000-8000-000000000001")
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([companyId, name, type])
  @@index([tenantId, id])
  @@index([companyId])
  @@schema("dev")
}

model FinancialTransaction {
  id          String            @id @default(uuid())
  tenantId    String            @default("00000000-0000-4000-8000-000000000010")
  description String
  amount      Decimal           @db.Decimal(12, 2)
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  date        DateTime
  dueDate     DateTime?
  categoryId  String
  userId      String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  contractId  String?
  title       String?
  clientId    String?
  companyId   String            @default("00000000-0000-4000-8000-000000000001")
  deletedAt   DateTime?         @map("deleted_at")
  deletedById String?           @map("deleted_by")
  category    FinancialCategory @relation(fields: [categoryId], references: [id])
  client      Client?           @relation(fields: [clientId], references: [id])
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract    Contract?         @relation(fields: [contractId], references: [id])
  deletedBy   User?             @relation("FinancialTransactionDeletedBy", fields: [deletedById], references: [id])
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, status])
  @@index([clientId])
  @@index([clientId, status])
  @@index([dueDate, status])
  @@index([contractId])
  @@index([deletedAt])
  @@index([companyId])
  @@schema("dev")
}

model KanbanColumn {
  id        String            @id @default(uuid())
  tenantId  String            @default("00000000-0000-4000-8000-000000000010")
  title     String
  order     Int               @default(0)
  color     String            @default("#004949")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  type      KanbanColumnType?
  companyId String            @default("00000000-0000-4000-8000-000000000001")
  statusKey KanbanTaskStatus?
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks     KanbanTask[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([order])
  @@index([companyId])
  @@schema("dev")
}

model KanbanTask {
  id                        String                @id @default(uuid())
  tenantId                  String                @default("00000000-0000-4000-8000-000000000010")
  title                     String
  description               String?
  postCaption               String?
  priority                  KanbanTaskPriority    @default(MEDIUM)
  order                     Int                   @default(0)
  dueDate                   DateTime?
  columnId                  String
  createdById               String
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  clientId                  String?
  referenceUrl              String?
  internalReviewStatus      InternalReviewStatus  @default(NOT_REQUIRED)
  internalReviewNote        String?
  contentPostId             String?               @unique
  calendarEventId           String?               @unique
  slaResponseDueAt          DateTime?
  slaResolutionDueAt        DateTime?
  firstResponseAt           DateTime?
  resolvedAt                DateTime?
  companyId                 String                @default("00000000-0000-4000-8000-000000000001")
  status                    KanbanTaskStatus      @default(FALTA_GRAVAR)
  productionPhase           ProductionPhase?
  assignedGroupId           String?
  deletedAt                 DateTime?
  deletedById               String?
  isBypassingInternalReview Boolean               @default(false)
  publicationDate           DateTime?
  deliveryDate              DateTime?
  contentType               KanbanTaskContentType @default(VIDEO_WITH_SCRIPT)
  assignedGroup             UserGroup?            @relation(fields: [assignedGroupId], references: [id])
  calendarEvent             CalendarEvent?        @relation(fields: [calendarEventId], references: [id])
  client                    Client?               @relation(fields: [clientId], references: [id])
  column                    KanbanColumn          @relation(fields: [columnId], references: [id], onDelete: Cascade)
  company                   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentPost               ContentPost?          @relation(fields: [contentPostId], references: [id])
  createdBy                 User                  @relation("KanbanTaskCreator", fields: [createdById], references: [id])
  deletedBy                 User?                 @relation("KanbanTaskDeletedBy", fields: [deletedById], references: [id])
  assets                    KanbanTaskAsset[]
  assignees                 KanbanTaskAssignee[]
  comments                  TaskComment[]
  history                   TaskHistory[]
  deliverable               Deliverable?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([columnId, order])
  @@index([clientId])
  @@index([assignedGroupId])
  @@index([deletedAt])
  @@index([companyId])
  @@index([publicationDate])
  @@index([deliveryDate])
  @@schema("dev")
}

model KanbanTaskAsset {
  id           String     @id @default(uuid())
  taskId       String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int?
  uploadedById String
  uploadedAt   DateTime   @default(now())
  caption      String?
  task         KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation("KanbanTaskAssetUploader", fields: [uploadedById], references: [id])

  @@index([taskId, uploadedAt])
  @@schema("dev")
}

model KanbanTaskAssignee {
  taskId String
  userId String
  task   KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@schema("dev")
}

model TaskComment {
  id        String     @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime   @default(now())
  task      KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@schema("dev")
}

model TaskHistory {
  id        String     @id @default(uuid())
  taskId    String
  userId    String
  action    String
  createdAt DateTime   @default(now())
  task      KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@schema("dev")
}

model CalendarEvent {
  id              String        @id @default(uuid())
  tenantId        String        @default("00000000-0000-4000-8000-000000000010")
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  category        EventCategory @default(MEETING)
  color           String?
  isPending       Boolean       @default(false)
  createdById     String
  assigneeId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  clientId        String?
  referenceUrl    String?
  contentPostId   String?       @unique
  companyId       String        @default("00000000-0000-4000-8000-000000000001")
  assignedGroupId String?
  assignedGroup   UserGroup?    @relation(fields: [assignedGroupId], references: [id])
  assignee        User?         @relation("EventAssignee", fields: [assigneeId], references: [id])
  client          Client?       @relation(fields: [clientId], references: [id])
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentPost     ContentPost?  @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("EventCreator", fields: [createdById], references: [id])
  kanbanTask      KanbanTask?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([startAt])
  @@index([assigneeId])
  @@index([assignedGroupId])
  @@index([clientId])
  @@index([companyId])
  @@schema("dev")
}

model Client {
  id                    String                      @id @default(uuid())
  tenantId              String                      @default("00000000-0000-4000-8000-000000000010")
  companyName           String
  contactName           String?
  email                 String?
  phone                 String?
  instagram             String?
  instagramUserId       String?
  metaAccessToken       String?
  website               String?
  street                String?
  number                String?
  city                  String?
  state                 String?
  zipCode               String?
  notes                 String?
  avatarUrl             String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  clientGroupId         String?
  document              String?
  neighborhood          String?
  companyId             String                      @default("00000000-0000-4000-8000-000000000001")
  isActive              Boolean                     @default(true)
  hasCrmEnabled         Boolean                     @default(false) @map("crm_enabled")
  assets                Asset[]
  calendarEvents        CalendarEvent[]
  clientGroup           ClientGroup?                @relation(fields: [clientGroupId], references: [id])
  company               Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  briefs                ClientBrief[]
  portalToken           ClientPortalToken?
  portalUser            ClientPortalUser?
  reports               ClientReport[]
  posts                 ContentPost[]
  contracts             Contract[]
  financialTransactions FinancialTransaction[]
  kanbanTasks           KanbanTask[]
  proposals             Proposal[]
  users                 User[]                      @relation("ClientUsers")
  calendarEntries       CalendarEntry[]
  financialAttachments  ClientFinancialAttachment[]
  reportFiles           ClientReportFile[]
  clientRequests        ClientRequest[]
  sdrAssignments        CrmSdrAssignment[]
  deliverables          Deliverable[]
  leads                 Lead[]
  tasks                 Task[]
  crmScopes             UserCrmScope[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, id])
  @@index([companyName])
  @@index([clientGroupId])
  @@index([companyId])
  @@schema("dev")
}

model UserCrmScope {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  clientId        String?  @map("client_id")
  includeInternal Boolean  @default(false) @map("include_internal")
  createdAt       DateTime @default(now()) @map("created_at")
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("user_crm_scopes")
  @@schema("dev")
}

model CrmSdrAssignment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  organization   Client   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("crm_sdr_assignments")
  @@schema("dev")
}

model UserGroup {
  id             String            @id @default(uuid())
  tenantId       String            @default("00000000-0000-4000-8000-000000000010")
  name           String
  description    String?
  color          String            @default("#E8C39E")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  companyId      String            @default("00000000-0000-4000-8000-000000000001")
  assignedEvents CalendarEvent[]
  assignedTasks  KanbanTask[]
  users          User[]
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members        UserGroupMember[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([tenantId, id])
  @@index([companyId])
  @@schema("dev")
}

model UserGroupMember {
  userId      String
  userGroupId String
  assignedAt  DateTime  @default(now())
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, userGroupId])
  @@index([userGroupId])
  @@schema("dev")
}

model ClientGroup {
  id          String   @id @default(uuid())
  tenantId    String   @default("00000000-0000-4000-8000-000000000010")
  name        String
  description String?
  color       String   @default("#E8C39E")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String   @default("00000000-0000-4000-8000-000000000001")
  clients     Client[]
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([tenantId, id])
  @@index([companyId])
  @@schema("dev")
}

model ClientReport {
  id            String   @id @default(uuid())
  tenantId      String   @default("00000000-0000-4000-8000-000000000010")
  clientId      String
  month         Int
  year          Int
  title         String
  data          Json
  generatedById String
  createdAt     DateTime @default(now())
  companyId     String   @default("00000000-0000-4000-8000-000000000001")
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedBy   User     @relation("ReportGenerator", fields: [generatedById], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([clientId, month, year])
  @@index([tenantId, id])
  @@index([clientId])
  @@index([companyId])
  @@schema("dev")
}

model ClientPortalToken {
  id             String    @id @default(uuid())
  clientId       String    @unique
  tokenHash      String    @unique
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@schema("dev")
}

model ClientPortalUser {
  id                 String                  @id @default(uuid())
  clientId           String                  @unique
  email              String                  @unique
  passwordHash       String
  temporaryPassword  String?
  mustChangePassword Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  authTokens         ClientPortalAuthToken[]
  client             Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@schema("dev")
}

model ClientPortalAuthToken {
  id           String           @id @default(uuid())
  tokenHash    String           @unique
  portalUserId String
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  portalUser   ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@schema("dev")
}

model ClientBrief {
  id                 String             @id @default(uuid())
  tenantId           String             @default("00000000-0000-4000-8000-000000000010")
  clientId           String
  title              String
  content            String
  source             String             @default("portal")
  createdAt          DateTime           @default(now())
  status             ClientBriefStatus  @default(OPEN)
  priority           KanbanTaskPriority @default(MEDIUM)
  assignedToId       String?
  slaResponseDueAt   DateTime?
  slaResolutionDueAt DateTime?
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  updatedAt          DateTime           @updatedAt
  companyId          String             @default("00000000-0000-4000-8000-000000000001")
  assignedTo         User?              @relation("BriefAssignee", fields: [assignedToId], references: [id])
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

